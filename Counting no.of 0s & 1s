#include <bits/stdc++.h>
#include <unordered_map>
using namespace std;

int main() {
    int n;
    cin >> n;
    vector<int> nums(n);

    for (int i = 0; i < n; i++) {
        cin >> nums[i];
    }
    unordered_map<int, int> map;

    int sum = 0;
    int maxLen = 0;

    map[0] = -1;

    for (int i = 0; i < n; i++) {
        if (nums[i] == 0) {
            sum--;
        } else {
            sum++;
        }

        if (map.find(sum) != map.end()) {
            int len = i - map[sum];
            if (len > maxLen) {
                maxLen = len;
            }
        } else {
            map[sum] = i;
        }
    }
    cout << maxLen << endl;

    return 0;
}
